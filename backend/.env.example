# ============================================
# MazikDLP Backend - Environment Configuration
# ============================================
# Copy this to .env and update values

# --- Application ---
APP_NAME=MazikDLP
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mazikdlp
DB_USER=mazikdlp_user
DB_PASSWORD=mazikdlp_secret_password
DB_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-very-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Presidio / NLP ---
NLP_MODEL=en_core_web_lg

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
